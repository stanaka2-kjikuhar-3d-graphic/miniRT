{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; \"$CLAUDE_PROJECT_DIR/.claude/hooks/update-header.sh\" \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Updating 42 header timestamp..."
          }
        ]
      }
    ]
  }
}
